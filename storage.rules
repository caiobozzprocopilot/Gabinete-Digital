rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos dos gabinetes: qualquer um pode ver, só autenticados podem enviar
    match /tenant-photos/{slug}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024   // max 10 MB
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
