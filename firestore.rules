rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Retorna true se o usuário autenticado tem role 'master'
    function isMaster() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'master';
    }

    // Dados públicos dos gabinetes — qualquer um pode ler
    match /tenants/{slug} {
      allow read: if true;
      // Admins autenticados podem criar/atualizar tenant; master tem acesso total
      allow write: if request.auth != null;
    }

    // Demandas — qualquer um pode criar, só autenticados podem ler/atualizar
    match /demands/{demandId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    // Perfis de admin
    match /adminUsers/{uid} {
      // O próprio usuário ou o master podem ler
      allow read: if request.auth != null && (request.auth.uid == uid || isMaster());

      // O usuário pode criar/editar o próprio perfil, MAS não pode se auto-promover:
      // o campo 'role' só é aceito se for 'operator' (ou ausente).
      allow write: if request.auth != null && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(['role'])
            || request.resource.data.role == 'operator');

      // O master pode gerenciar qualquer perfil, incluindo definir roles
      allow write: if isMaster();
    }
  }
}

